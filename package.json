{
	"name": "@liiift-studio/ragtooth",
	"version": "1.2.30",
	"description": "Deliberate sawtooth rag for the web — works with React, vanilla JS, or any framework",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.cjs",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "vite build",
		"build:webflow": "vite build --config vite.webflow.config.ts",
		"dev": "vite build --watch",
		"dev:site": "npm run dev & cd site && npm run dev",
		"typecheck": "tsc --noEmit",
		"lint": "tsc --noEmit",
		"test": "vitest",
		"test:run": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"capture": "npm run build && node scripts/capture.mjs",
		"prepublishOnly": "npm run test:run && npm run build && npm run build:webflow"
	},
	"keywords": [
		"typography",
		"web-typography",
		"frontend",
		"liiift-studio",
		"rag",
		"saw-rag",
		"sawtooth-rag",
		"ragtooth",
		"typographic-rhythm",
		"paragraph",
		"text-composition",
		"typesetting",
		"text",
		"react",
		"vanilla-js",
		"framework-agnostic",
		"letter-spacing",
		"zero-dependencies",
		"typescript",
		"css"
	],
	"author": "Quinn Keaveney <quinn@liiift.studio>",
	"license": "MIT",
	"homepage": "https://ragtooth.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Liiift-Studio/Ragtooth.git"
	},
	"bugs": {
		"url": "https://github.com/Liiift-Studio/Ragtooth/issues"
	},
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"react": ">=17.0.0",
		"react-dom": ">=17.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	},
	"devDependencies": {
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^4.0.0",
		"@vitest/ui": "^3.2.6",
		"happy-dom": "^20.10.6",
		"next": "16.2.2",
		"playwright": "^1.61.0",
		"typescript": "^5.0.0",
		"vite": "^5.0.0",
		"vite-plugin-dts": "^5.0.2",
		"vitest": "^3.2.6"
	}
}
